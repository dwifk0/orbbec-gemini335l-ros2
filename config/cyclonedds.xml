<?xml version="1.0" encoding="UTF-8"?>
<!-- Large receive buffer so UDP fragments of big messages (images, point clouds) are not dropped -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
